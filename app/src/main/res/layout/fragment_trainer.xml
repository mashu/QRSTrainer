<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="12dp"
    tools:context=".ui.trainer.TrainerFragment">

    <!-- Progress Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/progress_card"
        style="@style/Widget.App.CardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/progress_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level 1 - Progress: 75%"
                android:textAppearance="@style/TextAppearance.App.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                style="@style/Widget.App.LinearProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progress="75" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Sequence Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sequence_card"
        style="@style/Widget.App.CardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:minHeight="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@+id/control_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_card"
        app:layout_constraintVertical_bias="0.0">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/sequence_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Ready to train!\nPress START to begin."
                android:textAppearance="@style/TextAppearance.App.HeadlineMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />

            <!-- Audio visualization indicator -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/audio_visualization"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorPrimary">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_volume_up"
                    android:tint="?attr/colorOnPrimary" />
                    
            </com.google.android.material.card.MaterialCardView>

            <!-- Hint FAB -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_hint"
                style="@style/Widget.App.FloatingActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:contentDescription="Get Hint"
                android:src="@drawable/ic_lightbulb"
                android:visibility="gone"
                app:fabSize="mini"
                app:backgroundTint="?attr/colorTertiary"
                app:tint="?attr/colorOnTertiary" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Control Panel Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/control_card"
        style="@style/Widget.App.CardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_start"
                style="@style/Widget.App.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/button_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_stop"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="@string/button_stop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_replay"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/button_replay" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Morse Keyboard Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/keyboard_card"
        style="@style/Widget.App.CardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Character"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Morse keyboard using proper MorseKeyboard component -->
            <com.so5km.qrstrainer.ui.components.trainer.MorseKeyboard
                android:id="@+id/morse_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
